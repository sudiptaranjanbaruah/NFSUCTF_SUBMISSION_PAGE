{
    "name": "nfsu-guwahati/ctf-platform",
    "description": "NFSU Guwahati CTF platform (PHP + MySQL)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "phpmailer/phpmailer": "^6.9",
        "league/commonmark": "^2.4"
    },
    "autoload": {
        "psr-4": { "App\\": "app/src/" },
        "files": ["app/src/helpers.php"]
    },
    "config": { "platform": { "php": "8.1.0" }, "optimize-autoloader": true }
}
