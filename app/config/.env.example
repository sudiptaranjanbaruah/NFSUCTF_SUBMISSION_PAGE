# Copy to app/config/.env and fill in. Never commit the real .env.
APP_URL=https://ctf.example.com
APP_DEBUG=false
APP_KEY=generate-with-openssl-rand-hex-32
TRUST_PROXY=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nfsuctf
DB_USER=nfsuctf
DB_PASS=

# Mail: smtp sends for real, log writes mails to app/storage/logs/mail.log
MAIL_DRIVER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="NFSU Guwahati CTF"
MAIL_HOURLY_CAP=90

# OAuth (leave empty to hide the buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Max upload size for challenge files, in MB
UPLOAD_MAX_MB=50
